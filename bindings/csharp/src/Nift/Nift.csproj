<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Nift</AssemblyName>
    <RootNamespace>Nift</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>Nift</PackageId>
    <Version>$(Version)</Version>
    <Description>Nift Embed .NET binding: Nift template rendering for .NET applications over the frozen Nift C ABI.</Description>
    <Authors>antimatroid</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- Native runtime assets in the standard .NET RID layout. The linux-x64
         asset is staged from the repo-root library; the CI release matrix
         stages the other RIDs (linux-arm64, osx-x64, osx-arm64, win-x64). -->
    <None Include="$(MSBuildProjectDirectory)/../../../../libnift_c.so"
          Pack="true" PackagePath="runtimes/linux-x64/native/libnift_c.so" Visible="false"
          Condition="Exists('$(MSBuildProjectDirectory)/../../../../libnift_c.so')" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Nift.Tests" />
  </ItemGroup>
</Project>
