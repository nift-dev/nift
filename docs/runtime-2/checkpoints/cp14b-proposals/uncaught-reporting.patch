@@ -0,0 +1,29 @@
+#include "rt/vm_collection_report.h"
+
+// rt-lint: cold-file final uncaught collection diagnostic projection
+namespace nift::rt {
+void Vm::collection_error_context(VmResult& result, const Proto* proto, const Instr*) const {
+    bool expression_view = proto->collection_expression_view;
+    for (const Frame& frame : frames_)
+        expression_view = expression_view || frame.proto->collection_expression_view;
+    constexpr char recursion[] = "callable recursion depth exceeded";
+    if (expression_view && result.reason == StopReason::Error &&
+        result.message.rfind(recursion, 0) != 0 && result.message.rfind("lambda body error: ", 0) != 0)
+        result.message = "lambda body error: " + result.message;
+    for (auto it = frames_.rbegin(); it != frames_.rend(); ++it) {
+        const Instr* call = it->ret - 1;
+        if (call->op == OpCode::CollectionCall && !(call->c & kConstantBit))
+            result.diagnostic_frames.push_back(
+                {nift::detail::DiagnosticFrameKind::Callback, "collection callback", {}, {}});
+    }
+    // A primitive failure in a block's legacy expression view has the
+    // collection call's source view. An Error's stored origin is untouched;
+    // named/nested callees retain their own reporting/provenance rules.
+    if (proto->collection_expression_view && !result.error_origin && !frames_.empty()) {
+        const Frame& frame = frames_.back();
+        const Instr* call = frame.ret - 1;
+        if (call->op == OpCode::CollectionCall && !(call->c & kConstantBit))
+            result.offset = frame.proto->offsets[static_cast<std::size_t>(call - frame.proto->code.data())];
+    }
+}
+} // namespace nift::rt
