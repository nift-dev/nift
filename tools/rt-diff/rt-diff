#!/usr/bin/env python3
"""rt-diff: differential runner for two nift binaries (Runtime 2.0 CP08).

Runs every corpus entry with binary A and binary B in fresh temporary copies and
compares, channel by channel: exit codes, stdout, stderr, combined stdout+stderr
ordering (single-threaded scripts), output files (contents, modes, directories,
symlinks), `.nift/` metadata (page-info normalised as documented), files created
under HOME and TMPDIR, and the Host-operation trace (NIFT_TRACE_HOST), ordered
within each context (page, script, or async/thread task).

Entry kinds (discovered under each --corpus directory, sorted):
  *.f            standalone script, run as `nift <name>.f` in a copy of its directory
  *.eval         one expression per line, each run as `nift eval --json <expr>`
  <dir>/.nift    template site project; default step `nift build --all`
  <dir>/rt-diff.workspace
                 a workspace: the whole directory is copied (so a project can use
                 `..`, neighbour directories, external output directories and
                 relative symlinks); the file names the project subdirectory.
Sidecars:
  script  <name>.args (one argument per line), <name>.env (KEY=VALUE per line),
          <name>.stdin (bytes fed to stdin)
  site / workspace
          rt-diff.steps inside the directory, or <dir>.rt-diff.steps beside it:
          one step per line (see STEPS below); rt-diff.env / <dir>.rt-diff.env
STEPS (site and workspace entries; `$WS` expands to the copy's absolute path):
  nift ARGS...            run nift with ARGS (shell-like quoting) in the project
  write PATH TEXT         write TEXT (\\n escapes) to PATH (relative to the project)
  append PATH TEXT        append TEXT
  remove PATH             delete a file
  symlink TARGET PATH     create a symlink
  sleep SECONDS           wait (mtime-based incremental modes need a tick)

Exclusions (`rt-diff.ignore` in a corpus, or --ignore FILE): one entry pattern
per line, a mandatory `channels=` list (`stdout,combined`, or `all` to skip the
entry) and a reason after '#'; only the named channels are excluded. Approved
semantic differences: --policy FILE (JSON, see docs/runtime-2/rt-diff.md); a
policy matches one entry (id and source hash), one channel and an exact
old -> new substitution; unused policies are failures.

Isolation: A and B run one after the other in the SAME absolute directory (so
path-dependent values such as glob fingerprints are comparable without
normalisation), nested three levels below the snapshot root (writes that
escape the copy through `..` are snapshotted), each nift step in its own
session/process group (killed on timeout and after the step, so no process
outlives a run). A timeout on either side is always a difference.

Normalisations (the only ones; each is tested in tests/runtime2/rt_diff_selftest.sh):
  1. the copy's path -> $ROOT, HOME -> $HOME, TMPDIR -> $TMPDIR, the snapshot
     root -> $BASE (each also under its realpath only if that differs, e.g.
     macOS /var -> /private/var)
  2. for site and workspace steps only, a whole stdout/stderr line
     `time taken: <number> seconds` (Nift's build summary) -> `$T`
Exit status: 0 when no unapproved difference, 1 otherwise, 2 on usage errors.
"""
import argparse
import concurrent.futures as cf
import fnmatch
import hashlib
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.abspath(__file__))
CONTENT = {}   # file fingerprint -> normalised bytes (small files), for reports
TIME_LINE_RE = re.compile(rb"(?m)^time taken: [0-9.eE+-]+ seconds$")
CHANNELS = ("exit", "stdout", "stderr", "combined", "files", "home", "tmp", "trace", "ctx-order")
GOLDEN_SUFFIXES = (".stdout", ".stderr", ".exit", ".args", ".env", ".stdin", ".expect")


def usage_error(message):
    print(message, file=sys.stderr)
    sys.exit(2)


# --------------------------------------------------------------------- discovery
def discover(corpus_specs, global_ignore=()):
    entries, seen, errors = [], {}, []
    labels = {}
    for spec in corpus_specs:
        label, root = (spec.split("=", 1) if "=" in spec and not os.path.exists(spec) else (None, spec))
        root = os.path.abspath(root)
        if not os.path.isdir(root):
            errors.append("corpus directory does not exist: %s" % root)
            continue
        if not label:
            # The directory name, extended by parent names while it collides
            # with another corpus (bindings/python/app vs bindings/node/app ->
            # python/app, node/app), so ids are stable across checkouts.
            parts = root.split(os.sep)
            depth = 1
            label = parts[-1]
            while label in labels and labels[label] != root and depth < len(parts):
                depth += 1
                label = "/".join(parts[-depth:])
            if label in labels and labels[label] != root:
                errors.append("corpus label collision: %s" % root)
                continue
        labels[label] = root
        ignore = load_ignore(os.path.join(root, "rt-diff.ignore")) + [("@" + p, c) for p, c in global_ignore]
        before = len(entries)
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames.sort()
            rel_dir = os.path.relpath(dirpath, root)
            if "rt-diff.only" in filenames:
                # A self-contained tree with exactly one entry script (used by
                # extracted smoke scripts: modules and data files sit beside it).
                with open(os.path.join(dirpath, "rt-diff.only")) as handle:
                    only = handle.read().strip()
                add(entries, label, ignore, "script", os.path.join(dirpath, only),
                    os.path.normpath(os.path.join(rel_dir, only)), tree=dirpath)
                dirnames[:] = []
                continue
            if "rt-diff.workspace" in filenames:
                add(entries, label, ignore, "workspace", dirpath, rel_dir)
                dirnames[:] = []
                continue
            if ".nift" in dirnames and os.path.isfile(os.path.join(dirpath, ".nift", "config.json")):
                add(entries, label, ignore, "site", dirpath, rel_dir)
                dirnames[:] = []
                continue
            dirnames[:] = [d for d in dirnames if not d.startswith(".")]
            for name in sorted(filenames):
                path = os.path.join(dirpath, name)
                rel = os.path.normpath(os.path.join(rel_dir, name))
                if name.endswith(".f"):
                    add(entries, label, ignore, "script", path, rel)
                elif name.endswith(".eval"):
                    add(entries, label, ignore, "eval", path, rel)
        if len(entries) == before:
            errors.append("corpus directory has no entries: %s" % root)
    for entry in entries:
        if entry["id"] in seen:
            errors.append("duplicate entry id %s (%s and %s)" % (entry["id"], seen[entry["id"]], entry["path"]))
        seen[entry["id"]] = entry["path"]
    return entries, errors


def load_ignore(path):
    """Lines: `PATTERN channels=a,b|all # reason`. Returns (pattern, channels)."""
    patterns = []
    if path and os.path.isfile(path):
        with open(path) as handle:
            for line in handle:
                body, _, reason = line.partition("#")
                body = body.strip()
                if not body:
                    continue
                if not reason.strip():
                    usage_error("rt-diff: exclusion without a reason in %s: %s" % (path, body))
                fields = body.split()
                chans = [f for f in fields[1:] if f.startswith("channels=")]
                if len(fields) != 2 or not chans:
                    usage_error("rt-diff: exclusion needs `PATTERN channels=...` in %s: %s" % (path, body))
                value = chans[0].split("=", 1)[1]
                channels = "all" if value == "all" else tuple(value.split(","))
                if channels != "all" and not set(channels) <= set(CHANNELS):
                    usage_error("rt-diff: unknown channel in %s: %s" % (path, body))
                patterns.append((fields[0], channels))
    return patterns


def add(entries, label, ignore, kind, path, rel, tree=None):
    rel = rel.replace(os.sep, "/")
    entry_id = label + "/" + rel
    excluded = set()
    for pattern, channels in ignore:
        hit = fnmatch.fnmatch(entry_id, pattern[1:]) if pattern.startswith("@") else fnmatch.fnmatch(rel, pattern)
        if hit:
            if channels == "all":
                return
            excluded.update(channels)
    entry = {"kind": kind, "path": path, "id": entry_id, "excluded": sorted(excluded)}
    if tree:
        entry["tree"] = tree
    entries.append(entry)


# --------------------------------------------------------------------- running
def normalise(data, roots, build_summary=False):
    """roots: (path, token) pairs, longest path first. build_summary: also map
    Nift's own `time taken: N seconds` summary line (site/workspace steps)."""
    for root, token in roots:
        data = data.replace(root.encode(), token)
    if build_summary:
        data = TIME_LINE_RE.sub(b"time taken: $T seconds", data)
    return data


def sidecar(path, suffix, kind):
    if kind == "script":
        candidate = path[:-len(os.path.splitext(path)[1])] + suffix
    else:
        inside = os.path.join(path, "rt-diff" + suffix)
        candidate = inside if os.path.isfile(inside) else path.rstrip(os.sep) + ".rt-diff" + suffix
    if os.path.isfile(candidate):
        with open(candidate, "rb") as handle:
            return handle.read()
    return None


def parse_env(data):
    env = {}
    for line in (data or b"").decode().splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            key, value = line.split("=", 1)
            env[key.strip()] = value
    return env


def plan(entry, work):
    """Copies the entry to `work`; returns (project_dir, steps)."""
    kind, path = entry["kind"], entry["path"]
    skip = lambda d, names: [n for n in names if n.endswith(GOLDEN_SUFFIXES) or n in ("rt-diff.steps", "rt-diff.only")]
    if kind == "script":
        tree = entry.get("tree") or os.path.dirname(path)
        shutil.copytree(tree, work, symlinks=True, ignore=skip)
        cwd = os.path.join(work, os.path.relpath(os.path.dirname(path), tree))
        extra = sidecar(path, ".args", kind)
        args = extra.decode().splitlines() if extra else []
        return os.path.normpath(cwd), [("nift", [os.path.basename(path)] + args, sidecar(path, ".stdin", kind) or b"")]
    if kind == "eval":
        os.makedirs(work)
        with open(path) as handle:
            expressions = [line.rstrip("\n") for line in handle if line.strip() and not line.startswith("#")]
        return work, [("nift", ["eval", "--json", expr], b"") for expr in expressions]
    shutil.copytree(path, work, symlinks=True, ignore=skip)
    project = work
    if kind == "workspace":
        with open(os.path.join(path, "rt-diff.workspace")) as handle:
            sub = handle.read().strip()
        project = os.path.join(work, sub)
        os.remove(os.path.join(work, "rt-diff.workspace"))
    steps_data = sidecar(path, ".steps", kind)
    steps = []
    if steps_data:
        for line in steps_data.decode().splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            verb, _, rest = line.partition(" ")
            rest = rest.replace("$WS", work)
            if verb == "nift":
                steps.append(("nift", shlex.split(rest), b""))
            elif verb in ("write", "append"):
                target, _, text = rest.partition(" ")
                steps.append((verb, target, text.encode().decode("unicode_escape").encode()))
            elif verb in ("remove", "sleep"):
                steps.append((verb, rest))
            elif verb == "symlink":
                target, _, link = rest.partition(" ")
                steps.append(("symlink", target, link))
            else:
                usage_error("rt-diff: unknown step %r in %s" % (verb, entry["path"]))
    else:
        steps.append(("nift", ["build", "--all"], b""))
    # Every site/workspace ends with `nift status` (round-2 review): it reads
    # back the page-info Nift wrote, so wrong metadata surfaces as behaviour.
    if not (steps[-1][0] == "nift" and steps[-1][1][:1] == ["status"]):
        steps.append(("nift", ["status"], b""))
    return project, steps


def build_threads(project):
    try:
        with open(os.path.join(project, ".nift", "config.json")) as handle:
            return json.load(handle).get("config", {}).get("build-threads")
    except (OSError, ValueError, AttributeError):
        return None


def run_group(argv, cwd, env, stdin, timeout, pass_fds=(), stderr=subprocess.PIPE):
    """Runs argv in its own session; kills the whole process group on timeout
    and after completion (background descendants never outlive the step)."""
    proc = subprocess.Popen(argv, cwd=cwd, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=stderr, pass_fds=pass_fds, start_new_session=True)
    try:
        out, err = proc.communicate(stdin, timeout=timeout)
        code = proc.returncode
    except subprocess.TimeoutExpired:
        kill_group(proc.pid)
        out, err = proc.communicate()
        code = "timeout"
    kill_group(proc.pid)
    return code, out or b"", err or b""


def kill_group(pgid):
    try:
        os.killpg(pgid, 9)
    except (ProcessLookupError, PermissionError):
        pass


def roots_for(paths):
    """(path, token) pairs: each path, plus its realpath only if different."""
    pairs = {}
    for path_value, token in paths:
        pairs[path_value] = token
        real = os.path.realpath(path_value)
        if real != path_value:
            pairs[real] = token
    return sorted(pairs.items(), key=lambda item: len(item[0]), reverse=True)


def wipe(base):
    for name in os.listdir(base):
        full = os.path.join(base, name)
        if os.path.isdir(full) and not os.path.islink(full):
            shutil.rmtree(full, ignore_errors=True)
        else:
            os.remove(full)


def run_one(binary, entry, base, timeout, trace, combined_runs):
    """Runs one entry with one binary under `base` (an existing empty
    directory shared by A and B, so absolute paths are identical). The copy
    lives three levels down; the whole of `base` is snapshotted."""
    sandbox = os.path.join(base, "s", "t", "u")
    work, home, tmp = os.path.join(sandbox, "w"), os.path.join(sandbox, "home"), os.path.join(sandbox, "tmp")
    tracedir = tempfile.mkdtemp(prefix="rtdiff-trace-")
    roots = roots_for(((work, b"$ROOT"), (home, b"$HOME"), (tmp, b"$TMPDIR"), (base, b"$BASE")))
    site_like = entry["kind"] in ("site", "workspace")
    result = {"stdout": b"", "stderr": b"", "combined": [], "exit": [], "trace": [], "threads": None}

    def prepare():
        wipe(base)
        os.makedirs(home)
        os.makedirs(tmp)
        project, steps = plan(entry, work)
        env = {
            "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
            "HOME": home, "TMPDIR": tmp, "LANG": "C", "LC_ALL": "C", "TZ": "UTC",
            "TERM": "dumb", "NO_COLOR": "1",
        }
        env.update(parse_env(sidecar(entry["path"], ".env", entry["kind"])))
        return project, steps, env

    try:
        if combined_runs and entry["kind"] == "script":
            # stdout and stderr on one pipe records their relative order. Runs
            # first, each in a fresh copy, so its side effects never reach the
            # snapshot of the main run.
            for _ in range(combined_runs):
                project, steps, env = prepare()
                step = steps[0]
                _, out, _ = run_group([binary] + step[1], project, env, step[2], timeout, stderr=subprocess.STDOUT)
                result["combined"].append(normalise(out, roots))
        project, steps, env = prepare()
        threads = build_threads(project) if site_like else None
        result["threads"] = threads
        for index, step in enumerate(steps):
            verb = step[0]
            if verb != "nift":
                apply_step(step, project)
                if verb in ("write", "append", "remove", "symlink"):
                    # Let the filesystem clock move past the edit before the
                    # next nift step. Otherwise whether the edit lands in the
                    # render's own timestamp tick (CP01 `tick-hashes`) depends
                    # on scheduling and page-info differs between identical
                    # runs. This removes a harness-made race; nothing is
                    # normalised.
                    time.sleep(0.02)
                continue
            trace_path = os.path.join(tracedir, "trace-%d.jsonl" % index)
            trace_fd = os.open(trace_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            run_env = dict(env)
            if trace:
                run_env["NIFT_TRACE_HOST"] = str(trace_fd)
            marker = ("-- step %d: %s\n" % (index, " ".join(step[1][:3]))).encode() if len(steps) > 1 else b""
            try:
                code, out, err = run_group([binary] + step[1], project, run_env, step[2], timeout,
                                           pass_fds=(trace_fd,) if trace else ())
            finally:
                os.close(trace_fd)
            result["stdout"] += marker + normalise(out, roots, site_like)
            result["stderr"] += marker + normalise(err, roots, site_like)
            result["exit"].append(code)
            with open(trace_path, "rb") as handle:
                result["trace"].extend(parse_trace(normalise(handle.read(), roots)))
        snap = snapshot(base, roots)
        prefix_home = os.path.relpath(home, base).replace(os.sep, "/")
        prefix_tmp = os.path.relpath(tmp, base).replace(os.sep, "/")
        split = {"files": {}, "home": {}, "tmp": {}}
        for name, value in snap.items():
            if name == prefix_home + "/" or name.startswith(prefix_home + "/"):
                split["home"][name] = value
            elif name == prefix_tmp + "/" or name.startswith(prefix_tmp + "/"):
                split["tmp"][name] = value
            else:
                split["files"][name] = value
        result.update(split)
        return result
    finally:
        shutil.rmtree(tracedir, ignore_errors=True)


def apply_step(step, project):
    verb = step[0]
    if verb in ("write", "append"):
        target = os.path.join(project, step[1])
        os.makedirs(os.path.dirname(target) or ".", exist_ok=True)
        with open(target, "ab" if verb == "append" else "wb") as handle:
            handle.write(step[2])
    elif verb == "remove":
        os.remove(os.path.join(project, step[1]))
    elif verb == "symlink":
        os.symlink(step[1], os.path.join(project, step[2]))
    elif verb == "sleep":
        time.sleep(float(step[1]))


def parse_trace(data):
    """Each trace line is compared as a whole JSON object (every field, sorted
    keys), so unknown or extra fields are differences, not ignored."""
    events = []
    for line in data.splitlines():
        try:
            item = json.loads(line)
            if not isinstance(item, dict):
                raise ValueError
            events.append((str(item.get("ctx", "")), json.dumps(item, sort_keys=True, ensure_ascii=False)))
        except ValueError:
            events.append(("?", "unparsable: " + line.decode("utf-8", "replace")))
    return events


def trace_groups(events):
    """Operations grouped by context; order is compared within every context.
    Contexts are pages, `script`, or `<owner>/async#N` / `<owner>/thread#N`
    tasks numbered in creation order."""
    groups = {}
    for ctx, text in events:
        groups.setdefault(ctx, []).append(text)
    return groups


def context_order(events):
    """Order in which non-task contexts first appear (pages of a build)."""
    order = []
    for ctx, _ in events:
        if "/async#" in ctx or "/thread#" in ctx:
            continue
        if ctx not in order:
            order.append(ctx)
    return order


def snapshot(top, roots):
    entries = {}
    if not os.path.isdir(top):
        return entries
    for dirpath, dirnames, filenames in os.walk(top):
        dirnames.sort()
        rel_dir = os.path.relpath(dirpath, top).replace(os.sep, "/")
        for name in list(dirnames):
            full = os.path.join(dirpath, name)
            rel = os.path.normpath(os.path.join(rel_dir, name)).replace(os.sep, "/")
            if os.path.islink(full):
                entries[rel] = "link:" + normalise(os.readlink(full).encode(), roots).decode("utf-8", "replace")
                dirnames.remove(name)
                continue
            entries[rel + "/"] = "dir:%o" % stat.S_IMODE(os.lstat(full).st_mode)
        for name in sorted(filenames):
            full = os.path.join(dirpath, name)
            rel = os.path.normpath(os.path.join(rel_dir, name)).replace(os.sep, "/")
            if os.path.islink(full):
                entries[rel] = "link:" + normalise(os.readlink(full).encode(), roots).decode("utf-8", "replace")
                continue
            mode = stat.S_IMODE(os.lstat(full).st_mode)
            try:
                with open(full, "rb") as handle:
                    data = normalise(handle.read(), roots)
            except OSError as error:
                entries[rel] = "unreadable:%s" % error.errno
                continue
            entries[rel] = "%o:%s:%d" % (mode, hashlib.sha256(data).hexdigest(), len(data))
            if len(data) <= 8192:
                CONTENT[entries[rel]] = data
    return entries


# --------------------------------------------------------------------- comparing
def first_difference(a, b):
    a_lines = a.splitlines() if isinstance(a, (bytes, str)) else a
    b_lines = b.splitlines() if isinstance(b, (bytes, str)) else b
    for index in range(max(len(a_lines), len(b_lines))):
        left = a_lines[index] if index < len(a_lines) else "<end>"
        right = b_lines[index] if index < len(b_lines) else "<end>"
        if left != right:
            show = lambda v: v.decode("utf-8", "replace") if isinstance(v, bytes) else str(v)
            return {"line": index + 1, "a": show(left)[:300], "b": show(right)[:300]}
    return None


def compare(a, b, use_trace, excluded=()):
    diffs = []
    if "timeout" in a["exit"] or "timeout" in b["exit"]:
        # A timeout is never "equal": partial output proves nothing.
        diffs.append({"channel": "timeout", "first": {"a": a["exit"], "b": b["exit"]}})
    for key in ("exit", "stdout", "stderr"):
        if key not in excluded and a[key] != b[key]:
            diffs.append({"channel": key, "first": first_difference(a[key], b[key]) if key != "exit" else {"a": a[key], "b": b[key]}})
    if "combined" not in excluded and a["combined"] and b["combined"]:
        if all(run == a["combined"][0] for run in a["combined"]):
            if b["combined"][0] != a["combined"][0]:
                diffs.append({"channel": "combined", "first": first_difference(a["combined"][0], b["combined"][0])})
        else:
            a["combined_unstable"] = True
    for key in ("files", "home", "tmp"):
        if key not in excluded and a[key] != b[key]:
            names = sorted(set(a[key]) | set(b[key]))
            changed = [n for n in names if a[key].get(n) != b[key].get(n)]
            first = {"changed": changed[:10], "count": len(changed),
                     "a": [a[key].get(n) for n in changed[:3]], "b": [b[key].get(n) for n in changed[:3]]}
            fa, fb = a[key].get(changed[0]), b[key].get(changed[0])
            if fa in CONTENT and fb in CONTENT:
                first["content"] = first_difference(CONTENT[fa], CONTENT[fb])
            diffs.append({"channel": key, "first": first})
    if use_trace and "trace" not in excluded:
        ga, gb = trace_groups(a["trace"]), trace_groups(b["trace"])
        for ctx in sorted(set(ga) | set(gb)):
            if ga.get(ctx) != gb.get(ctx):
                diffs.append({"channel": "trace", "context": ctx,
                              "first": first_difference(ga.get(ctx, []), gb.get(ctx, []))})
        # Page order is deterministic only in single-threaded builds.
        if a.get("threads") == 1 and "ctx-order" not in excluded:
            oa, ob = context_order(a["trace"]), context_order(b["trace"])
            if oa != ob:
                diffs.append({"channel": "ctx-order", "first": first_difference(oa, ob)})
    return diffs


# --------------------------------------------------------------------- policies
POLICY_CHANNELS = ("stdout", "stderr", "combined", "exit")
REPO = os.path.normpath(os.path.join(HERE, "..", ".."))


def source_hash(entry):
    """sha256 of the entry's source: the file for scripts/evals, every file of
    the directory (sorted, golden/sidecar files excluded) for sites/workspaces."""
    digest = hashlib.sha256()
    path = entry["path"]
    if os.path.isfile(path):
        with open(path, "rb") as handle:
            digest.update(handle.read())
        return digest.hexdigest()
    for dirpath, dirnames, filenames in os.walk(path):
        dirnames.sort()
        for name in sorted(filenames):
            full = os.path.join(dirpath, name)
            digest.update(os.path.relpath(full, path).encode() + b"\0")
            if not os.path.islink(full):
                with open(full, "rb") as handle:
                    digest.update(handle.read())
    return digest.hexdigest()


def load_policies(paths):
    """Approved semantic differences. Each rule:
      {"id": "...", "decision": "D-009#6", "entry": "<exact entry id>",
       "source_sha256": "<sha256 of the entry source>",
       "channel": "stdout|stderr|combined|exit", "old": "<exact text in A>",
       "new": "<exact text in B>", "count": N, "justification": "...",
       "test": "<repo path of the test case> [notes]"}
    The difference is approved only for that entry id with that exact source,
    and only if replacing exactly `count` occurrences of `old` by `new` in A's
    channel yields B's channel byte for byte (for `exit`, old/new are the exit
    codes as strings). A rule that approves nothing is a failure."""
    rules = []
    required = ("id", "decision", "entry", "source_sha256", "channel", "old", "new", "count", "justification", "test")
    ids = set()
    for path in paths:
        with open(path) as handle:
            for rule in json.load(handle):
                missing = [k for k in required if k not in rule]
                rid = rule.get("id", "?")
                problems = []
                if missing:
                    problems.append("lacks " + ", ".join(missing))
                else:
                    if "*" in rule["entry"] or "?" in rule["entry"] or "[" in rule["entry"]:
                        problems.append("entry must be exact, not a pattern")
                    if rule["channel"] not in POLICY_CHANNELS:
                        problems.append("channel must be one of %s" % ", ".join(POLICY_CHANNELS))
                    if not isinstance(rule["old"], str) or not rule["old"]:
                        problems.append("`old` must be non-empty text")
                    if rule["old"] == rule["new"]:
                        problems.append("`old` and `new` are identical")
                    if not isinstance(rule["count"], int) or rule["count"] < 1:
                        problems.append("`count` must be a positive integer")
                    if not re.match(r"^D-\d{3}#\d+(,#\d+)*$", str(rule["decision"])):
                        problems.append("`decision` must name decision rows like D-009#6 or D-009#3,#4")
                    if not re.match(r"^[0-9a-f]{64}$", str(rule["source_sha256"])):
                        problems.append("`source_sha256` must be a sha256")
                    test_path = str(rule["test"]).split()[0] if str(rule["test"]).split() else ""
                    if not test_path or not os.path.exists(os.path.join(REPO, test_path)):
                        problems.append("`test` must start with an existing repository path (got %r)" % test_path)
                    if rid in ids:
                        problems.append("duplicate id")
                if problems:
                    usage_error("rt-diff: policy %s: %s" % (rid, "; ".join(problems)))
                ids.add(rid)
                rules.append(rule)
    return rules


def apply_policies(entry, a, b, diffs, rules, used=None):
    approved, remaining = [], []
    entry_hash = None
    for diff in diffs:
        rule = None
        for candidate in rules:
            if candidate["entry"] != entry["id"] or candidate["channel"] != diff["channel"]:
                continue
            entry_hash = entry_hash or source_hash(entry)
            if candidate["source_sha256"] == entry_hash and policy_matches(candidate, a, b):
                rule = candidate
                break
        if rule:
            approved.append({"channel": diff["channel"], "policy": rule["id"], "decision": rule["decision"]})
            if used is not None:
                used.add(rule["id"])
        else:
            remaining.append(diff)
    return approved, remaining


def policy_matches(rule, a, b):
    channel = rule["channel"]
    if channel == "exit":
        expected = [str(x) for x in a["exit"]]
        actual = [str(x) for x in b["exit"]]
        hits = sum(1 for x in expected if x == rule["old"])
        replaced = [rule["new"] if x == rule["old"] else x for x in expected]
        return hits == rule["count"] and replaced == actual
    old, new = rule["old"].encode(), rule["new"].encode()
    if channel == "combined":
        left, right = (a["combined"] or [b""])[0], (b["combined"] or [b""])[0]
    else:
        left, right = a[channel], b[channel]
    if left.count(old) != rule["count"]:
        return False
    return left.replace(old, new) == right


# --------------------------------------------------------------------- minimising
def minimise(entry, a_bin, b_bin, options, rules, out_dir):
    """Line-based delta minimisation of a generated script while the
    difference persists. The whole entry directory (modules, data) is copied;
    the original difference is re-checked first and the final reproducer is
    re-checked before it is reported. Returns a dict describing the outcome."""
    tree = entry.get("tree") or os.path.dirname(entry["path"])
    script_rel = os.path.relpath(entry["path"], tree)
    with open(entry["path"]) as handle:
        lines = handle.read().splitlines()
    scratch = tempfile.mkdtemp(prefix="rtdiff-min-")
    copy = os.path.join(scratch, "tree")
    shutil.copytree(tree, copy, symlinks=True)
    base = tempfile.mkdtemp(prefix="rtdiff-minrun-")

    def still_differs(candidate):
        script = os.path.join(copy, script_rel)
        with open(script, "w") as handle:
            handle.write("\n".join(candidate) + "\n")
        probe = {"kind": "script", "path": script, "id": entry["id"], "tree": copy, "excluded": entry.get("excluded", [])}
        timeout = min(options.timeout, 10.0)
        runs = 0 if options.no_interleave else 1
        a = run_one(a_bin, probe, base, timeout, not options.no_trace, runs)
        if "timeout" in a["exit"]:
            return False          # a candidate that hangs is not a reproducer
        b = run_one(b_bin, probe, base, timeout, not options.no_trace, runs)
        if "timeout" in b["exit"]:
            return False
        diffs = compare(a, b, not options.no_trace, entry.get("excluded", ()))
        return bool(apply_policies(probe, a, b, diffs, rules)[1])

    try:
        if not still_differs(lines):
            return {"status": "not-reproduced", "note": "the difference did not recur in isolation; nothing minimised"}
        chunk = max(1, len(lines) // 2)
        budget = 120
        while chunk >= 1 and budget > 0:
            index, changed = 0, False
            while index < len(lines) and budget > 0:
                candidate = lines[:index] + lines[index + chunk:]
                budget -= 1
                if candidate and still_differs(candidate):
                    lines, changed = candidate, True
                else:
                    index += chunk
            if not changed:
                chunk //= 2
        verified = still_differs(lines)
        name = entry["id"].replace("/", "_")
        target_dir = os.path.join(out_dir, name)
        if os.path.exists(target_dir):
            shutil.rmtree(target_dir)
        shutil.copytree(copy, target_dir, symlinks=True)   # holds the minimised script
        replay = os.path.join(target_dir, "replay.sh")
        with open(replay, "w") as handle:
            handle.write("#!/bin/sh\n# %s; minimised from %s; reproduces: %s\n"
                         % (entry.get("origin", ""), entry["path"], "yes" if verified else "NO"))
            handle.write("cd \"$(dirname \"$0\")/%s\"\nfor b in %s %s; do echo \"== $b\"; \"$b\" %s </dev/null; echo \"exit $?\"; done\n"
                         % (os.path.dirname(script_rel) or ".", shlex.quote(a_bin), shlex.quote(b_bin),
                            shlex.quote(os.path.basename(script_rel))))
        os.chmod(replay, 0o755)
        return {"status": "verified" if verified else "unverified", "dir": target_dir,
                "file": os.path.join(target_dir, script_rel), "lines": len(lines), "replay": replay}
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
        shutil.rmtree(base, ignore_errors=True)


# --------------------------------------------------------------------- main
def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--a", required=True, help="reference nift binary")
    parser.add_argument("--b", required=True, help="candidate nift binary")
    parser.add_argument("--corpus", action="append", default=[], help="corpus directory ([LABEL=]DIR, repeatable)")
    parser.add_argument("--gen", type=int, default=0, help="also run N generated programs (tools/rt-diff/gen.py)")
    parser.add_argument("--seed", type=int, default=1, help="generator seed")
    parser.add_argument("--jobs", type=int, default=os.cpu_count() or 2)
    parser.add_argument("--timeout", type=float, default=30.0, help="seconds per entry and binary")
    parser.add_argument("--no-trace", action="store_true", help="do not compare Host-op traces")
    parser.add_argument("--trace-neutrality", action="store_true",
                        help="run A with tracing and B without; compare every channel except the trace")
    parser.add_argument("--no-interleave", action="store_true", help="skip the combined stdout+stderr run")
    parser.add_argument("--report", help="write a JSON report here")
    parser.add_argument("--ignore", action="append", default=[], help="file of entry-id patterns to skip")
    parser.add_argument("--policy", action="append", default=[], help="approved-difference policy file (JSON)")
    parser.add_argument("--min-entries", type=int, default=1, help="fail if fewer entries are discovered")
    parser.add_argument("--repro-dir", help="write minimised reproducers of differing generated programs here")
    parser.add_argument("--repro-limit", type=int, default=3, help="minimise at most this many programs")
    parser.add_argument("--extract-smoke", metavar="TESTS_DIR", help="also run scripts extracted from smoke-test heredocs")
    parser.add_argument("--quiet", action="store_true")
    options = parser.parse_args()
    for binary in (options.a, options.b):
        if not os.access(binary, os.X_OK):
            print("rt-diff: not executable: %s" % binary, file=sys.stderr)
            return 2
    corpus = list(options.corpus)
    generated = None
    if options.gen:
        generated = tempfile.mkdtemp(prefix="rtdiff-gen-")
        subprocess.run([sys.executable, os.path.join(HERE, "gen.py"), "--count", str(options.gen),
                        "--seed", str(options.seed), "--out", os.path.join(generated, "gen")], check=True)
        corpus.append(os.path.join(generated, "gen"))
    if options.extract_smoke:
        generated = generated or tempfile.mkdtemp(prefix="rtdiff-gen-")
        subprocess.run([sys.executable, os.path.join(HERE, "extract_smoke.py"), "--tests", options.extract_smoke,
                        "--out", os.path.join(generated, "smoke")], check=True, stdout=subprocess.DEVNULL)
        corpus.append(os.path.join(generated, "smoke"))
    if not corpus:
        print("rt-diff: no corpus", file=sys.stderr)
        return 2
    global_ignore = []
    for path in options.ignore:
        global_ignore += load_ignore(path)
    rules = load_policies(options.policy)
    try:
        entries, errors = discover(corpus, global_ignore)
        if len(entries) < options.min_entries:
            errors.append("only %d entries discovered (minimum %d)" % (len(entries), options.min_entries))
        if errors:
            for error in errors:
                print("rt-diff: %s" % error, file=sys.stderr)
            return 2
        a_bin, b_bin = os.path.abspath(options.a), os.path.abspath(options.b)
        use_trace = not options.no_trace and not options.trace_neutrality
        interleave = not options.no_interleave

        used = set()

        def job(entry):
            base = tempfile.mkdtemp(prefix="rtdiff-")
            try:
                # A twice on the combined channel: its order is compared only
                # if A reproduces it (measured stability, not a guess).
                a = run_one(a_bin, entry, base, options.timeout, use_trace or options.trace_neutrality, 2 if interleave else 0)
                b = run_one(b_bin, entry, base, options.timeout, use_trace, 1 if interleave else 0)
            finally:
                shutil.rmtree(base, ignore_errors=True)
            diffs = compare(a, b, use_trace, entry.get("excluded", ()))
            approved, remaining = apply_policies(entry, a, b, diffs, rules, used)
            return entry, approved, remaining, len(a["trace"]), a.get("combined_unstable", False)

        results = []
        with cf.ThreadPoolExecutor(max_workers=max(1, options.jobs)) as pool:
            for entry, approved, diffs, events, unstable in pool.map(job, entries):
                results.append({"id": entry["id"], "kind": entry["kind"], "diffs": diffs,
                                "approved": approved, "trace_events": events, "path": entry["path"],
                                "combined_unstable": unstable, "excluded": entry.get("excluded", [])})
        differing = [r for r in results if r["diffs"]]
        approved = [r for r in results if r["approved"]]
        counts = {}
        for r in results:
            counts[r["kind"]] = counts.get(r["kind"], 0) + 1
        if not options.quiet:
            for r in differing:
                for d in r["diffs"]:
                    ctx = (" [%s]" % d["context"]) if "context" in d else ""
                    print("DIFF %s %s%s %s" % (r["id"], d["channel"], ctx, json.dumps(d["first"], ensure_ascii=False)))
            for r in approved:
                for d in r["approved"]:
                    print("APPROVED %s %s %s (%s)" % (r["id"], d["channel"], d["policy"], d["decision"]))
        if options.repro_dir:
            generated_diffs = [r for r in differing if "/gen/" in r["path"] and r["path"].endswith(".f")]
            by_id = {e["id"]: e for e in entries}
            for r in generated_diffs[:options.repro_limit]:
                entry = dict(by_id[r["id"]], origin=origin_of(r["path"]))
                outcome = minimise(entry, a_bin, b_bin, options, rules, options.repro_dir)
                r["reproducer"] = outcome
                if outcome["status"] == "verified":
                    print("REPRO %s -> %s (%d lines, verified)" % (r["id"], outcome["file"], outcome["lines"]))
                else:
                    print("REPRO-WARNING %s: %s" % (r["id"], outcome.get("note") or "minimised program does not reproduce"))
        unused = sorted(r["id"] for r in rules if r["id"] not in used)
        for rid in unused:
            print("UNUSED-POLICY %s (approved nothing in this run)" % rid)
        unstable = sum(1 for r in results if r["combined_unstable"])
        traced = sum(1 for r in results if r["trace_events"])
        events = sum(r["trace_events"] for r in results)
        summary = {"entries": len(results), "by_kind": counts, "differing": len(differing),
                   "approved": len(approved), "entries_with_trace": traced, "trace_events": events,
                   "channels": sorted({d["channel"] for r in differing for d in r["diffs"]}),
                   "trace": use_trace, "seed": options.seed, "generated": options.gen,
                   "combined_unstable": unstable, "unused_policies": unused,
                   "command": " ".join(shlex.quote(a) for a in sys.argv)}
        print("rt-diff: %d entries %s, %d differing, %d approved; %d entries traced (%d Host ops); "
              "combined order unstable (not compared) in %d; %d unused policies"
              % (len(results), json.dumps(counts, sort_keys=True), len(differing), len(approved), traced, events,
                 unstable, len(unused)))
        if options.report:
            with open(options.report, "w") as handle:
                json.dump({"summary": summary, "results": results}, handle, indent=1, sort_keys=True)
        return 1 if differing or unused else 0
    finally:
        if generated:
            shutil.rmtree(generated, ignore_errors=True)


def origin_of(path):
    try:
        with open(path) as handle:
            first = handle.readline().strip()
        return first.lstrip("/ ").strip() if first.startswith("//") else ""
    except OSError:
        return ""


if __name__ == "__main__":
    sys.exit(main())
