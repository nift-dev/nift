# Relocatable nift.pc: prefix resolves from the .pc location, so it works both
# from a source checkout (packaging/nift.pc -> repo root) and when installed at
# <prefix>/lib/pkgconfig/nift.pc (-> <prefix>).
#
# Static-by-default: libnift_c is linked statically (-Wl,-Bstatic -lnift_c
# -Wl,-Bdynamic), so Go consumers get a self-contained binary without needing to
# install/locate libnift_c.so at runtime. The shared library is still shipped
# for consumers that explicitly choose dynamic linking. C++/libc runtime remain
# dynamic as usual.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: nift
Description: Nift Embedded rendering library (frozen C ABI; Nift 4.0.7)
Version: 4.0.7
Libs: -L${libdir} -Wl,-Bstatic -lnift_c -Wl,-Bdynamic -lstdc++ -lm -pthread
Cflags: -I${includedir}
